# =========================================================================
# DIGVOS SYSTEM ENVIRONMENT VARIABLES (TEMPLATE)
# Copy file này thành .env và điền các thông tin bảo mật thực tế của bạn.
# =========================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/digvos?schema=public"

# 2. GOOGLE GEMINI API CONFIGURATION
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 3. AUTH0 CONFIGURATION (Authentication & Identity Provider)
AUTH0_SECRET="use-a-long-random-string-at-least-32-characters"
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_ISSUER_BASE_URL="https://YOUR_DOMAIN.auth0.com"
AUTH0_DOMAIN="YOUR_DOMAIN.auth0.com"
AUTH0_AUDIENCE="https://api.digvos.com"
AUTH0_CLIENT_ID="YOUR_AUTH0_CLIENT_ID"
AUTH0_CLIENT_SECRET="YOUR_AUTH0_CLIENT_SECRET"

# 4. BLOCKCHAIN CONFIGURATION (Polygon Amoy Testnet)
POLYGON_AMOY_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
RELAYER_PRIVATE_KEY="YOUR_WALLET_PRIVATE_KEY_WITHOUT_0x_PREFIX"
NEXT_PUBLIC_SBT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# 5. STORAGE CONFIGURATION (Supabase S3 Storage)
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="digvos-portfolio"
# S3 Compatibility API for Supabase Storage
STORAGE_ENDPOINT="https://ID.storage.supabase.co/storage/v1/s3"
STORAGE_REGION="ap-soet-1"
STORAGE_ACCESS_KEY="YOUR_SUPABASE_S3_ACCESS_KEY_ID_HERE"
STORAGE_SECRET_KEY="YOUR_SUPABASE_S3_SECRET_ACCESS_KEY_HERE"
STORAGE_BUCKET="digvos-portfolio"

# 6. REDIS CONFIGURATION (Caching, Queue & Realtime Presence)
REDIS_HOST="localhost"
REDIS_PORT=6379

# 7. PAYMENT CONFIGURATION (VietQR / PayOS)
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY"

# 8. SERVER CONFIGURATION (NestJS Backend API)
PORT=4000
API_URL="http://localhost:4000"

# 9. EMAIL SERVICE CONFIGURATION (Resend API Key)
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"

# 10. INITIAL SEED ADMIN CONFIGURATION
INITIAL_ADMIN_EMAIL="admin@digvos.local"
INITIAL_ADMIN_PASSWORD="admin123456"
